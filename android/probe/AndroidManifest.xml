<?xml version="1.0" encoding="utf-8"?>
<!-- CodexAstraUlt: This original diagnostic shell exercises packaged CPU fixture
     libraries only. It has no network, external storage or vendor-service permission. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.droidds.probe"
    android:versionCode="2"
    android:versionName="0.0.2">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35" />
    <!-- CodexAstraUlt: Extraction makes installer-owned nativeLibraryDir the
         explicit loader input. Debuggable permits adb run-as to read one private report. -->
    <application
        android:label="DroidDS Probe"
        android:allowBackup="false"
        android:debuggable="true"
        android:testOnly="true"
        android:extractNativeLibs="true"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".ProbeActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
