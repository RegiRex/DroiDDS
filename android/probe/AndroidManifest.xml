<?xml version="1.0" encoding="utf-8"?>
<!-- CodexAstraUlt: Version 0.0.6 correction 2 uses install code 7 to distinguish
     its pacing/audio/input observations without promoting the 0.0.7 game gate.
     Reports use a user-selected document URI;
     no network, broad storage or vendor-service permission is required. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.droidds.probe"
    android:versionCode="7"
    android:versionName="0.0.6">
    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="35" />
    <!-- CodexAstraUlt: Extraction makes installer-owned nativeLibraryDir the
         explicit loader input. Debuggable permits adb run-as to read one private report. -->
    <application
        android:label="DroidDS Probe"
        android:allowBackup="false"
        android:debuggable="true"
        android:testOnly="true"
        android:extractNativeLibs="true"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- CodexAstraUlt: Only the app can open the trusted original guest;
             external intents cannot select native libraries or private paths. -->
        <activity android:name=".HomebrewActivity" android:exported="false"
            android:enableOnBackInvokedCallback="false" />
        <activity android:name=".ProbeActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
